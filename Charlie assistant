<!DOCTYPE html>
<html lang="ur" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>JARVIS Local AI</title>

<script type="module">
import * as webllm from
"https://esm.run/@mlc-ai/web-llm";

let engine;

const status = document.getElementById("status");
const chat = document.getElementById("chat");

async function loadAI() {
  status.innerText = "Local AI model لوڈ ہو رہا ہے...";

  try {
    engine = await webllm.CreateMLCEngine(
      "Llama-3.2-1B-Instruct-q4f16_1-MLC"
    );

    status.innerText = "JARVIS تیار ہے۔";
  } catch (e) {
    status.innerText =
      "AI لوڈ نہیں ہو سکا۔ Chrome/WebGPU سپورٹ چیک کریں۔";
    console.error(e);
  }
}

window.askJarvis = async function () {

  const input =
    document.getElementById("message");

  const text = input.value.trim();

  if (!text) return;

  chat.innerHTML +=
    "<p><b>آپ:</b> " + text + "</p>";

  input.value = "";

  if (!engine) {
    status.innerText = "پہلے AI model لوڈ ہونے دیں۔";
    return;
  }

  status.innerText = "JARVIS سوچ رہا ہے...";

  const response =
    await engine.chat.completions.create({
      messages: [
        {
          role: "system",
          content:
          "آپ JARVIS ہیں۔ صارف سے اردو میں مختصر اور دوستانہ انداز میں بات کریں۔"
        },
        {
          role: "user",
          content: text
        }
      ]
    });

  const answer =
    response.choices[0].message.content;

  chat.innerHTML +=
    "<p><b>JARVIS:</b> " + answer + "</p>";

  const voice =
    new SpeechSynthesisUtterance(answer);

  voice.lang = "ur-PK";

  speechSynthesis.cancel();
  speechSynthesis.speak(voice);

  status.innerText = "JARVIS تیار ہے۔";
};

window.addEventListener("DOMContentLoaded", loadAI);
</script>

<style>
body{
  background:#07111f;
  color:white;
  font-family:Arial;
  text-align:center;
  padding:20px;
}

#chat{
  max-width:600px;
  margin:20px auto;
  padding:15px;
  min-height:300px;
  background:#132235;
  border-radius:15px;
  text-align:right;
}

input{
  padding:14px;
  width:70%;
  border-radius:10px;
  border:0;
}

button{
  padding:14px 20px;
  border:0;
  border-radius:10px;
  background:#1687ff;
  color:white;
}

#status{
  color:#5ee7ff;
}
</style>
</head>

<body>

<h1>🤖 JARVIS</h1>

<p id="status">
AI شروع ہو رہا ہے...
</p>

<div id="chat">
  <p>السلام علیکم! میں JARVIS ہوں۔</p>
</div>

<input
  id="message"
  placeholder="اردو میں سوال لکھیں..."
>

<button onclick="askJarvis()">
بھیجیں
</button>

</body>
</html>